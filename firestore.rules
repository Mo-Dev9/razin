rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Buildings — public read, no client writes
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews — read any, write own only
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['buildingId','userId','ratings','overall','comment','createdAt'])
        && request.resource.data.overall >= 1 && request.resource.data.overall <= 5
        && request.resource.data.ratings is map
        && request.resource.data.ratings.keys().hasAll(['zahma','humidity','landlord','neighbors','cleanliness','safety','services','annoyance','elevator','maintenance','ac'])
        && request.resource.data.ratings.zahma >= 1 && request.resource.data.ratings.zahma <= 5
        && request.resource.data.ratings.humidity >= 1 && request.resource.data.ratings.humidity <= 5
        && request.resource.data.ratings.landlord >= 1 && request.resource.data.ratings.landlord <= 5
        && request.resource.data.ratings.neighbors >= 1 && request.resource.data.ratings.neighbors <= 5
        && request.resource.data.ratings.cleanliness >= 1 && request.resource.data.ratings.cleanliness <= 5
        && request.resource.data.ratings.safety >= 1 && request.resource.data.ratings.safety <= 5
        && request.resource.data.ratings.services >= 1 && request.resource.data.ratings.services <= 5
        && request.resource.data.ratings.annoyance >= 1 && request.resource.data.ratings.annoyance <= 5
        && request.resource.data.ratings.elevator >= 1 && request.resource.data.ratings.elevator <= 5
        && request.resource.data.ratings.maintenance >= 1 && request.resource.data.ratings.maintenance <= 5
        && request.resource.data.ratings.ac >= 1 && request.resource.data.ratings.ac <= 5;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Users — read any, write own only
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Votes — read any, write own only, one per review per user
    match /votes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['up', 'down'];
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
