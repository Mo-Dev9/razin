rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Buildings — public read, no client writes
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews — read any, no client writes (all writes via server API + Admin SDK)
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Users — read any, write own only
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Votes — read any, no client writes (all writes via server API + Admin SDK)
    match /votes/{voteId} {
      allow read: if true;
      allow write: if false;
    }

    // Visits — read any, no client writes (all writes via server API + Admin SDK)
    match /visitDays/{day} {
      allow read: if true;
      allow write: if false;
    }

    match /visitPages/{page} {
      allow read: if true;
      allow write: if false;
    }

    // Reports — read any, no client writes (all writes via server API + Admin SDK)
    match /reports/{reportId} {
      allow read: if true;
      allow write: if false;
    }

    // Saved buildings — each user manages their own bookmarks
    match /users/{userId}/savedBuildings/{buildingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
