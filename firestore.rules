rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Buildings — silent legacy collection; public read, no client writes
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews — silent legacy collection; same treatment
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Users — read any, write own only
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Listings (price ads) — public read; all writes via server API + Admin SDK
    match /listings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    // Questions — read any; writes land via server API (participant policy lands Week 3)
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }

    // Question replies — same policy
    match /questions/{questionId}/replies/{replyId} {
      allow read: if true;
      allow write: if false;
    }

    // Manual-collection queue (protected pages recorded by the crawler) — read any, no client writes
    match /collectionQueue/{queueId} {
      allow read: if true;
      allow write: if false;
    }

    // Visits — read any, no client writes (all writes via server API + Admin SDK)
    match /visitDays/{day} {
      allow read: if true;
      allow write: if false;
    }

    match /visitPages/{page} {
      allow read: if true;
      allow write: if false;
    }
  }
}