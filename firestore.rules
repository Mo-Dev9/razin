rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Buildings — public read, no client writes
    match /buildings/{buildingId} {
      allow read: if true;
      allow write: if false;
    }

    // Reviews — read any, no client writes (all writes via server API + Admin SDK)
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Users — read any, write own only
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Votes — read any, write own only, one per review per user
    match /votes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['up', 'down'];
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
